# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.pytest_cache/
**/__pycache__/
*.py[cod]

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Local surveillance media, generated reviews, and runtime state
/audit-output/
/output/
/tmp/
/runtime/
/secure-state/
/camera-data/private/
/config/side-door-alert.json
/config/side-door-closed-baseline.jpg
/config/com.codex.side-door-alert-58.plist

# Model weights are downloaded locally when an analysis needs them
/*.pt
/yolo*_openvino_model/

# Local runtime diagnostics
/kernel.errors.txt
